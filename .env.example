# ──────────────────────────────────────────────────
#  SERVER
# ──────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ──────────────────────────────────────────────────
#  DATABASE  (PostgreSQL via Prisma)
# ──────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/scoutcard?schema=public"

# ──────────────────────────────────────────────────
#  JWT
# ──────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# ──────────────────────────────────────────────────
#  DISCORD OAUTH 2.0
# ──────────────────────────────────────────────────
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_REDIRECT_URI=http://localhost:3001/api/v1/auth/discord/callback

# ──────────────────────────────────────────────────
#  TRACKER.GG API (Valorant verification)
# ──────────────────────────────────────────────────
TRACKER_API_KEY=your_tracker_gg_api_key
TRACKER_BASE_URL=https://public-api.tracker.gg/v2/valorant

# ──────────────────────────────────────────────────
#  FRONTEND URL  (for CORS)
# ──────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ──────────────────────────────────────────────────
#  RATE LIMITING
# ──────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
